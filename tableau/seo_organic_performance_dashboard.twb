        <view>
          <datasources>
            <datasource caption='keyword_id+ (internship_project)' name='federated.0kad7l11gxtscz1e6xurk1t6pcoy' />
          </datasources>
          <datasource-dependencies datasource='federated.0kad7l11gxtscz1e6xurk1t6pcoy'>
            <column caption=' Estimated Ad Value' datatype='real' name='[Calculation_0357651422134272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_traffic]) * AVG([average_cpc])' />
            </column>
            <column caption='Demand Capture Rate' datatype='real' name='[Calculation_0357651422355457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_traffic]) / SUM([total_search_volume])) * 100' />
            </column>
            <column caption='Position Tier Flag' datatype='string' name='[Calculation_0409262062428168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [avg_position] &lt;= 2.0 &#10;THEN &quot;Top Rank (Pos 1-2)&quot;&#10;ELSEIF [avg_position] &lt;= 4.0 &#10;THEN &quot;Competitive Tier (Pos 2-4)&quot;&#10;ELSE &quot;Striking / High Growth (&gt;4)&quot;&#10;END' />
            </column>
            <column caption='Traffic Potential Score' datatype='real' name='[Calculation_0409262064615433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_search_volume] * (1 / [avg_position])' />
            </column>
            <column caption='Striking Distance Share' datatype='real' name='[Calculation_0409262180237322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [avg_position] &gt; 2.0 AND [avg_position] &lt;= 4.0 THEN [total_search_volume] ELSE 0 END) / SUM([total_search_volume])' />
            </column>
            <column caption='Total Quick-Win Potential Score' datatype='real' name='[Calculation_0409262180630539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_0409262064615433])' />
            </column>
            <column caption='Total Addressable Search Demand' datatype='integer' name='[Calculation_0409262180974604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_search_volume])' />
            </column>
            <column caption='Portfolio Average Keyword Difficulty' datatype='real' name='[Calculation_0409262181122061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_0409262064615433])' />
            </column>
